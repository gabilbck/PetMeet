# Banco de dados principal (usado pela API)
DATABASE_URL=postgresql+asyncpg://petmeet:petmeet@localhost:5432/petmeet

# Banco de dados usado exclusivamente pela suite de testes automatizados
DATABASE_URL_TESTE=postgresql+asyncpg://petmeet:petmeet@localhost:5432/petmeet_teste

# Autenticacao (RNF01, RNF16 - nunca versionar a chave real usada em producao)
SECRET_KEY=troque-esta-chave-por-um-valor-aleatorio-e-secreto
ALGORITMO_JWT=HS256
TOKEN_EXPIRACAO_MINUTOS=60

# CORS - origens do front-end autorizadas a consumir a API (separadas por virgula)
ORIGENS_PERMITIDAS=http://localhost:3000,http://localhost:5173

# Upload de fotos dos pets (RF19, RNF09)
DIRETORIO_UPLOADS=uploads
TAMANHO_MAX_UPLOAD_MB=5

# Ambiente: desenvolvimento | teste | producao
AMBIENTE=desenvolvimento
